pkgname=linux-oppo-a38
pkgver=5.10.160
pkgrel=2
pkgdesc="OPPO A38 kernel (prebuilt)"
arch="aarch64"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
license="GPL-2.0-only"
url="https://postmarketos.org"
depends=""
makedepends=""
source="Image.gz"

build() {
	return 0
}

package() {
	# Install the prebuilt kernel image
	install -Dm644 "$startdir/Image.gz" \
		"$pkgdir/boot/vmlinuz-oppo-a38"
	
	# Create dummy modules directory to prevent mkinitfs from crashing
	_kver="$pkgver-oppo-a38"
	mkdir -p "$pkgdir/lib/modules/$_kver"
	touch "$pkgdir/lib/modules/$_kver/modules.order"
	touch "$pkgdir/lib/modules/$_kver/modules.builtin"
}
